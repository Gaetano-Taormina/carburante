{
  "name": "fuelfinder-italy",
  "private": true,
  "version": "1.2.4",
  "description": "Trova i distributori di carburante più economici in Italia",
  "keywords": [
    "carburante",
    "prezzi",
    "mappa",
    "italia",
    "benzina",
    "diesel",
    "fuel",
    "italy"
  ],
  "author": "FuelFinder",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host\" \"node server/server.js\"",
    "start": "node server/server.js",
    "sync": "node server/sync-cli.js",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build --emptyOutDir --logLevel warn && node -e \"console.log('\\n✅ Build successful (dist/)\\n')\"",
    "preview": "vite preview",
    "stats": "node server/stats-cli.js",
    "lint": "oxlint -c .oxlintrc.json",
    "test": "node scripts/test-runner.js all",
    "test:unit": "node scripts/test-runner.js unit",
    "test:integration": "node scripts/test-runner.js integration",
    "test:e2e": "node scripts/test-runner.js e2e",
    "test:coverage": "node scripts/test-runner.js coverage",
    "release": "node scripts/release.js",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.{js,jsx}": "oxlint -c .oxlintrc.json"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-router-dom": "^7.18.3",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.81.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^5.0.0"
  }
}
